        ["axle_FL", "am5corolla_wheels_toyota", "axf1l", "axf1ll", "fh2l", {"x":0, "y":0, "z":0}, {"x":1, "y":0, "z":0} , {"x":0, "y":0, "z":0}, -360, 360, 0, 1, {"baseTranslation":{"x":0.087, "y":0, "z":0.0}, "optional":true}],
        ["axle_RR", "am5corolla_wheels_toyota", "axr1r", "axr1rr", "rh2r", {"x":0, "y":0, "z":0}, {"x":-1, "y":0, "z":0}, {"x":0, "y":0, "z":0}, -360, 360, 0, 1, {"baseTranslation":{"x":0.087, "y":0, "z":0.0}, "optional":true}],
        ["axle_RL", "am5corolla_wheels_toyota", "axr1l", "axr1ll", "rh2l", {"x":0, "y":0, "z":0}, {"x":1, "y":0, "z":0} , {"x":0, "y":0, "z":0}, -360, 360, 0, 1, {"baseTranslation":{"x":0.087, "y":0, "z":0.0}, "optional":true}],
